	"customizations": {
		"vscode": {
			"settings": {
				"cmake.buildDirectory": "/tmp/build",
				"cmake.configureArgs": ["-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"]
			},
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools"
			]
		}
	},
	"remoteUser": "vscode"
